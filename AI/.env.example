# ══════════════════════════════════════════════════════════════
#  Emour AI 환경설정 예시  (.env 로 복사해서 값 채우기)
#  ⚠️ .env 는 절대 커밋하지 마세요. 이 파일(.env.example)만 커밋합니다.
#
#  이 파일은 서로 다른 두 기능의 설정을 함께 담고 있습니다.
#    ① 채팅 감정 분석  (LLM_*, LOCAL_*, MOCK_* 등 1~5번 섹션)
#    ② 답장(문구) 추천  (GMS_*, SUGGEST_* — 맨 아래 섹션)
#  이름이 비슷한 값(BASE_URL, MODEL 등)이 있어도 서로 다른 설정입니다.
#  절대 같은 값으로 맞추지 마세요 — 아래 각 섹션에서 별도로 설명합니다.
# ══════════════════════════════════════════════════════════════

# ═══════════════════ ① 채팅 감정 분석 ═══════════════════

# ── 1. 공급자 선택 (여기 한 줄만 바꾸면 전부 갈아끼워집니다) ──
#   mock              : 실제 호출 없음. 토큰 0.  ← 평소 개발/연동용 기본값
#   openai            : OpenAI 공식
#   openai_compatible : OpenAI 규격을 따르는 모든 서비스 (아래 LLM_BASE_URL 필요)
#   anthropic         : Claude 계열 (pip install anthropic 필요)
#   local             : 파인튜닝 KcELECTRA 모델 (★우리 서비스의 운영값. torch·transformers 필요)
#                       빠른 오프라인 테스트만 필요하면 mock 으로 바꾸세요.
#
#   ⚠️ 이 줄을 지우거나 비워두면 "local"이 되는 게 아니라
#       구버전 호환 로직(USE_MOCK_LLM 값에 따라 mock 또는 openai)으로 자동 전환됩니다.
#       운영 환경에서는 반드시 이 줄을 명시적으로 채워두세요.
LLM_PROVIDER=local

# ── 2. 목업 전략 (LLM_PROVIDER=mock 일 때만 의미 있음) ──
#   hash  : message_id → 항상 같은 감정. 안정적 (권장 기본)
#   cycle : 배치 순번대로 15라벨 순환. FE가 15개 UI 한 번에 확인할 때
#   rule  : 키워드 규칙 + hash. 시연/데모에서 그럴듯하게 보일 때
MOCK_STRATEGY=hash

# ── 3. 실제 호출 설정 (LLM_PROVIDER=openai / openai_compatible / anthropic 일 때) ──
LLM_API_KEY=
LLM_MODEL=gpt-4.1-nano
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

#  LLM_BASE_URL — LLM_PROVIDER=openai_compatible 일 때만 채웁니다.
#  (아래 ②번 GMS_BASE_URL 과는 완전히 별개의 값입니다. 헷갈리지 마세요.)
#    Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#    Upstage     https://api.upstage.ai/v1
#    OpenRouter  https://openrouter.ai/api/v1
#    Ollama(로컬) http://localhost:11434/v1
LLM_BASE_URL=

#  ANTHROPIC_API_KEY — LLM_PROVIDER=anthropic 일 때만 필요.
# ANTHROPIC_API_KEY=

#  LOCAL_MODEL_PATH — LLM_PROVIDER=local 일 때 필수. HF repo id 또는 로컬 폴더 경로.
#  ⚠️ 비워두면 코드 기본값("emour-emotion-kcelectra", 네임스페이스 없음)으로
#      존재하지 않는 repo를 찾다가 서버가 아예 기동에 실패합니다. 반드시 아래처럼 채우세요.
LOCAL_MODEL_PATH=chlgks/emour-emotion-kcelectra

#  HF_TOKEN — 위 repo가 비공개(private)일 때만 필요. 공개 repo면 비워둬도 됩니다.
# HF_TOKEN=hf_xxx

#  LOCAL_USE_CONTEXT — 로컬 모델이 직전 대화(context)를 함께 볼지 여부.
#    false(기본): 메시지 1건씩 단독 분석. ← 지금 배포된 '단일 문장 학습' 모델용 안전 기본값
#    true       : 직전 대화를 붙여 문장쌍으로 분석([CLS] 맥락 [SEP] 대상 [SEP]).
#    ⚠️ 맥락을 학습한 모델을 배포한 뒤에만 true 로 켜세요.
#       단일 문장 모델에 켜면 안 배운 입력 형태라 정확도가 오히려 떨어질 수 있습니다.
LOCAL_USE_CONTEXT=false

#  구조화 출력(structured outputs): 응답 JSON 을 스키마로 강제.
#  켜면 15라벨 밖의 값을 모델이 아예 만들 수 없습니다.
#  ⚠️ 모델·공급자마다 지원 여부가 다릅니다. 지원 안 하면 false 로 두세요.
USE_STRUCTURED_OUTPUT=false

# ── 4. 배치 상한 (백엔드와 합의된 계약) ──
MAX_TARGET=10
MAX_CONTEXT=10

# ── 5. 실험 기록용 ──
#  run_eval.py 결과 파일에 실험 이름표로 붙습니다. 실험할 때마다 바꿔주면 결과 구분이 쉽습니다.
#    예: EXP_NAME=v1_baseline_gpt41nano
EXP_NAME=v0_baseline

# ── 구버전 호환 (LLM_PROVIDER 가 비어 있을 때만 참조됨) ──
# USE_MOCK_LLM=true
# OPENAI_API_KEY=


# ═══════════════════ ② 답장(문구) 추천 ═══════════════════
# gpt-4.1 + v3 프롬프트 조합. 근거: docs/suggest_experiment_report.md

#  SUGGEST_ENABLED — 킬 스위치. 크레딧 절약/장애 대응 시 재배포 없이 끌 수 있습니다.
#    true(기본) : 정상 동작
#    false      : LLM 호출 자체를 안 하고 즉시 blocked(disabled) 응답. 크레딧 소모 없음.
SUGGEST_ENABLED=true

#  GMS_API_KEY — GMS 발급 키. 위 ①번 LLM_API_KEY 와는 별개로 관리됩니다.
GMS_API_KEY=발급받은_api_key

#  GMS_BASE_URL — 반드시 OpenAI 호환(Chat Completions) 경로여야 합니다.
#  ⚠️ GMS는 OpenAI 계열과 Anthropic 계열의 실제 경로가 서로 다릅니다.
#     Anthropic 경로(.../api.anthropic.com)를 잘못 넣으면
#     "Invalid URL (POST /v1/chat/completions/chat/completions)" 에러가 납니다.
#     예: https://gms.ssafy.io/gmsapi/api.openai.com/v1
GMS_BASE_URL=https://gms.ssafy.io/gmsapi/api.openai.com/v1

#  SUGGEST_MODEL — 실험으로 확정된 값(gpt-4.1). 다른 모델로 바꾸려면
#  poc/suggest_experiment.py 로 먼저 재검증 후 바꾸는 걸 권장합니다.
SUGGEST_MODEL=gpt-4.1

#  SUGGEST_TEMPERATURE — 0에 가까울수록 매번 비슷한 문구, 1에 가까울수록 다양해짐.
#  0.7 은 "버튼 누를 때마다 다른 표현"이 나오도록 실험으로 확정한 값.
SUGGEST_TEMPERATURE=0.7

#  SUGGEST_TIMEOUT_SEC — 이 시간 안에 LLM 응답이 없으면 실패 처리(재시도 후 llm_failure).
#  버튼 클릭 UX 특성상 너무 길게 잡지 마세요.
SUGGEST_TIMEOUT_SEC=8

#  INTERNAL_API_KEY — routers_suggest.py 의 선택적 내부 호출 인증.
#  비워두면 인증 검증 없이 동작(내부망 신뢰 모드, 현재 기본).
#  값을 채우면 BE가 X-Internal-Api-Key 헤더에 같은 값을 실어 보내야 통과합니다.
# INTERNAL_API_KEY=
