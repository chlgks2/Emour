# ── OpenAI ──
OPENAI_API_KEY=your_openai_api_key

# ── LLM 설정 ──
LLM_MODEL=gpt-4o-mini
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

# ── 배치 상한 ──
MAX_TARGET=10
MAX_CONTEXT=10

# ── 목업 스위치 ──
# true 로 켜면 실제 LLM을 호출하지 않고 정해진 목업 응답을 리턴합니다(비용 0).
# BE/FE 연동 확인 단계에서 사용하세요. 실제 LLM으로 돌리려면 false 로 바꾸면 됩니다.
USE_MOCK_LLM=true
