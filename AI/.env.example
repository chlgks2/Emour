# ══════════════════════════════════════════════════════════════
#  Emour AI 환경설정 예시  (.env 로 복사해서 값 채우기)
#  ⚠️ .env 는 절대 커밋하지 마세요. 이 파일(.env.example)만 커밋합니다.
# ══════════════════════════════════════════════════════════════

# ── 1. 공급자 선택 (여기 한 줄만 바꾸면 전부 갈아끼워집니다) ──
#   mock              : 실제 호출 없음. 토큰 0.  ← 평소 개발/연동용 기본값
#   openai            : OpenAI 공식
#   openai_compatible : OpenAI 규격을 따르는 모든 서비스 (아래 BASE_URL 필요)
#   anthropic         : Claude 계열 (pip install anthropic 필요)
#   local             : 파인튜닝 KcELECTRA 로컬/HF 모델 (torch·transformers 필요)
LLM_PROVIDER=mock

# ── 2. 목업 전략 (LLM_PROVIDER=mock 일 때만 의미 있음) ──
#   hash  : message_id → 항상 같은 감정. 안정적 (권장 기본)
#   cycle : 배치 순번대로 15라벨 순환. FE가 15개 UI 한 번에 확인할 때
#   rule  : 키워드 규칙 + hash. 시연/데모에서 그럴듯하게 보일 때
MOCK_STRATEGY=hash

# ── 3. 실제 호출 설정 ──
LLM_API_KEY=
LLM_MODEL=gpt-4.1-nano
LLM_TEMPERATURE=0
LLM_TIMEOUT=30
LLM_MAX_RETRIES=1

#  LLM_BASE_URL — openai_compatible 일 때만 채웁니다.
#    Gemini      https://generativelanguage.googleapis.com/v1beta/openai/
#    Upstage     https://api.upstage.ai/v1
#    OpenRouter  https://openrouter.ai/api/v1
#    Ollama(로컬) http://localhost:11434/v1
LLM_BASE_URL=

#  LOCAL_MODEL_PATH — LLM_PROVIDER=local 일 때만. HF repo id 또는 로컬 폴더 경로.
#    예) youngwoo/emour-emotion-kcelectra   (공개 repo 면 서버에 토큰 불필요)
#    비공개 repo 면 HF_TOKEN=hf_xxx 도 함께 설정.
LOCAL_MODEL_PATH=

#  구조화 출력(structured outputs): 응답 JSON 을 스키마로 강제.
#  켜면 15라벨 밖의 값을 모델이 아예 만들 수 없습니다.
#  ⚠️ 모델·공급자마다 지원 여부가 다릅니다. 지원 안 하면 false 로 두세요.
USE_STRUCTURED_OUTPUT=false

# ── 4. 배치 상한 (백엔드와 합의된 계약) ──
MAX_TARGET=10
MAX_CONTEXT=10

# ── 5. 실험 기록용 ──
EXP_NAME=v0_baseline

# ── 구버전 호환 (LLM_PROVIDER 가 비어 있을 때만 참조됨) ──
# USE_MOCK_LLM=true
# OPENAI_API_KEY=
