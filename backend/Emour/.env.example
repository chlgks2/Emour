# ════════════════════════════════════════════════════════════
#  로컬 개발용 환경변수 견본.
#  이 파일을 복사해서 같은 폴더에 ".env" 로 저장하면 로컬 개발이 바로 동작합니다.
#     (Windows) copy .env.example .env
#     (mac/linux) cp .env.example .env
#  ⚠️ .env 는 git 에 올라가지 않습니다(비밀값 보호). 이 견본(.env.example)만 커밋합니다.
# ════════════════════════════════════════════════════════════

# ── MySQL (로컬 Docker 가 이 값으로 자동 생성. 각자 PC 전용이라 아무 값이나 OK) ──
MYSQL_DATABASE=emour
MYSQL_USER=emour
MYSQL_PASSWORD=emour1234
MYSQL_ROOT_PASSWORD=root1234

# ── Spring datasource 플레이스홀더 (실제 접속은 spring-boot-docker-compose 가 자동 주입) ──
DB_URL=jdbc:mysql://localhost:3306/emour
DB_USERNAME=emour
DB_PASSWORD=emour1234

# ── Redis ──
REDIS_PORT=6379

# ── AI 감정분석 ──
LLM_PROVIDER=local
LOCAL_MODEL_PATH=chlgks/emour-emotion-kcelectra
LOCAL_USE_CONTEXT=false

# ── 구글 소셜 로그인 ──
#   client ID 는 비밀이 아닙니다(프론트에도 노출되는 공개값). 그대로 두면 로그인 동작.
GOOGLE_CLIENT_ID=1029043609489-hgtj3l62pd03jg1t87aeoh7j0g1c2faa.apps.googleusercontent.com

# ── 이메일 인증 ──
#   console(기본): 인증코드가 "백엔드 콘솔 로그"에 출력됩니다. 로컬 테스트는 이걸로 충분합니다.
#                  (실제 메일은 안 나가요. 콘솔에 찍힌 6자리 코드를 그대로 입력해서 테스트)
#   smtp        : 실제 Gmail 발송. 이때만 아래 계정/앱비밀번호가 필요합니다.
EMAIL_MODE=console
#   ⚠️ 실제 발송 테스트가 꼭 필요할 때만 채우세요. 앱 비밀번호는 단톡방 금지 — 보안 채널로만 공유.
MAIL_USERNAME=
MAIL_PASSWORD=
