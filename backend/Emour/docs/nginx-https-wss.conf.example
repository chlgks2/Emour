# 실제 인증서 경로와 upstream 주소는 배포 서버 환경에 맞게 바꿉니다.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 80;
    server_name i15b208.p.ssafy.io;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name i15b208.p.ssafy.io;

    ssl_certificate /etc/letsencrypt/live/i15b208.p.ssafy.io/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/i15b208.p.ssafy.io/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    # REST 요청의 /api 접두사를 제거하고 Spring Boot로 전달합니다.
    location /api/ {
        proxy_pass http://127.0.0.1:8080/;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
    }

    # 같은 /ws 엔드포인트에서 WebSocket과 SockJS 요청을 모두 처리합니다.
    location ^~ /ws {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto https;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}
